<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 录音（喊话输入） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 音频输出与焦点 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 前台服务（保活，保证喊话随时可用） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 悬浮喊话按钮 / 日志监听：均为 specialUse 类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 车机开机自启前台服务与通知栏控制 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      悬浮窗：对齐 Hey! 的 FloatingWindowService。
      注意：SYSTEM_ALERT_WINDOW 需用户在系统设置中手动授予（见设置页引导）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      系统日志：对齐 Hey! 的 LogcatTriggerService。
      READ_LOGS 是 signature|privileged 级权限，普通安装申请不生效，
      必须由用户执行一次：
        adb shell pm grant com.vongz.holler android.permission.READ_LOGS
      未授予时服务自动降级为「仅读本应用日志」，不会崩溃。
    -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />

    <!-- TTS：Android 11+ 包可见性限制，需声明查询目标 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- 车机应用声明：告诉系统这是一个车用应用 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Holler"
        tools:targetApi="36">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 喊话前台服务：通知栏常驻控制与保活 -->
        <service
            android:name=".audio.HollerForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="in-car voice broadcast notification controls and keepalive" />
        </service>

        <!-- 悬浮喊话按钮（对齐 Hey! FloatingWindowService） -->
        <service
            android:name=".audio.FloatingTalkService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating talk button overlay for in-car voice broadcast" />
        </service>

        <!-- 日志关键词触发（对齐 Hey! LogcatTriggerService） -->
        <service
            android:name=".audio.LogcatTriggerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="monitor logcat keywords to trigger car voice broadcast" />
        </service>

        <!--
          外部命令接收器（对齐 Hey! HeyCommandReceiver）。
          导出：方控按键映射 / 第三方自动化工具需要发广播进来。
        -->
        <receiver
            android:name=".audio.HollerCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vongz.holler.action.START_TALK" />
                <action android:name="com.vongz.holler.action.STOP_TALK" />
                <action android:name="com.vongz.holler.action.TOGGLE_TALK" />
                <action android:name="com.vongz.holler.action.PLAY_PHRASE" />
            </intent-filter>
        </receiver>

        <!-- 车机开机与唤醒自启接收器 -->
        <receiver
            android:name=".audio.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
