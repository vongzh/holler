# ---------------------------------------------------------------------------
# 行尾统一：仓库以 LF 存储，检出时按平台还原
#   Windows 上提交时若把脚本/配置写成 CRLF，Linux CI 会因 `\r` 报
#   `bad interpreter: No such file or directory` —— 在 CI 跑之前先在这里钉死。
# ---------------------------------------------------------------------------
* text=auto

# Shell / Gradle 启动脚本必须 LF（含 shebang，执行时不能被 CRLF 污染）
*.sh        text eol=lf
gradlew     text eol=lf
gradlew.bat text eol=crlf

# 构建与配置文件：统一 LF，避免跨平台 diff 抖动
*.gradle    text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.toml      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.kt        text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.md        text eol=lf
*.pro       text eol=lf

# 仓库自身的元文件：与平台无关，也统一 LF
.editorconfig  text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
LICENSE        text eol=lf
NOTICE         text eol=lf

# 二进制资源：禁止行尾转换与 diff
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ico       binary
*.jar       binary
*.jks       binary
*.keystore  binary

# 语言统计：把设计评审稿与截图排除在「代码」之外
docs/design/** linguist-documentation
